{
  "name": "hrithik-paul-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/smoke.mjs && node scripts/fallback.mjs && node scripts/phase4.mjs && node scripts/phase6.mjs",
    "test:phase4": "node scripts/phase4.mjs",
    "test:phase6": "node scripts/phase6.mjs",
    "bundle:guard": "node scripts/bundle-guard.mjs",
    "analyze": "npm run build && node scripts/bundle-guard.mjs",
    "verify": "npm run typecheck && npm run lint && npm run build",
    "seo": "node scripts/seo.mjs",
    "seo:inject": "node scripts/seo.mjs --inject dist",
    "brand": "node scripts/brand-assets.mjs",
    "links": "node scripts/check-links.mjs",
    "prepare": "husky",
    "prebuild": "node scripts/seo.mjs",
    "postbuild": "node scripts/seo.mjs --inject dist",
    "capture": "node scripts/capture.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "@react-three/postprocessing": "3.1.3",
    "lenis": "1.3.26",
    "lucide-react": "^0.545.0",
    "postprocessing": "6.39.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "playwright": "^1.63.0",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1",
    "vitest": "^5.0.3",
    "wait-on": "^9.5.1"
  }
}
