# ============================================================================
# Portfolio environment — copy to `.env.local` and fill in what you use.
# Everything here is optional; the site builds and runs with none of them set.
# Never commit a real `.env.local` — only this example file belongs in git.
# ============================================================================

# Canonical site URL used for sitemap, canonical link, OG tags and JSON-LD.
# Defaults to https://hrithikpaul.dev when unset. On Vercel preview deploys
# the build picks up VERCEL_URL automatically, so leave this unset there.
# VITE_SITE_URL=https://hrithikpaul.dev

# Privacy-friendly analytics endpoint (POSTs minimal JSON: path + mode).
# Unset = analytics fully inert, zero requests leave the browser.
# For Umami this is your instance's /api/send (or the cloud collect URL);
# for Plausible, your self-hosted /api/event. Honors Do Not Track always.
# NOTE: if the endpoint is not same-origin, add its host to `connect-src` in
# vercel.json, otherwise the CSP will block the beacon.
# VITE_ANALYTICS_ENDPOINT=
# VITE_ANALYTICS_SITE=hrithikpaul.dev
