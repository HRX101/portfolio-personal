{
  "ci": {
    "collect": {
      "numberOfRuns": 2
    },
    "assert": {
      "assertions": {
        /*
         * Performance warns only: CI runners have no GPU, so the 3D number
         * measures SwiftShader, not the site. The real perf gates are the
         * bundle budget (bundle-guard.mjs, hard fail) and the Phase 7
         * Lighthouse table in the launch report, measured on demand.
         */
        "categories:performance": ["warn", { "minScore": 0.5 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 1 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
